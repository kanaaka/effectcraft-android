diff --git a/crates/ui-egui/Cargo.toml b/crates/ui-egui/Cargo.toml
index be02fef..4aca3aa 100644
--- a/crates/ui-egui/Cargo.toml
+++ b/crates/ui-egui/Cargo.toml
@@ -22,7 +22,14 @@ effectcraft-render = { workspace = true }
 effectcraft-engine = { workspace = true }
 effectcraft-gpu = { workspace = true }
 egui = { workspace = true }
-eframe = { workspace = true, features = ["default_fonts", "wgpu", "accesskit"] }
+# `accesskit` is declared separately, under `cfg(not(target_os = "android"))`, below: eframe
+# `compile_error!`s when `accesskit` and `android-native-activity` meet (egui's accesskit
+# integration on Android goes through the GameActivity backend, while the Android package
+# targets NativeActivity). Cargo applies features only from the target tables whose cfg
+# matches, so the desktop keeps accesskit and Android never asks for it. Cargo unions features
+# across the whole graph, so this has to be fixed *here*, in the only crate that enables
+# accesskit — the Android shell crate cannot turn it off from outside.
+eframe = { workspace = true, features = ["default_fonts", "wgpu"] }
 serde = { workspace = true }
 serde_json = { workspace = true }
 log = { workspace = true }
@@ -34,6 +41,12 @@ image = { workspace = true }
 [target.'cfg(not(target_arch = "wasm32"))'.dependencies]
 sys-locale = { workspace = true }
 
+# The desktop's accessibility tree (screen readers, VoiceOver/Narrator/UIA). Android's side of
+# it needs the GameActivity backend, which `apps/effectcraft-android` does not use, so the
+# feature is simply absent there — see the comment on the base `eframe` dependency above.
+[target.'cfg(not(target_os = "android"))'.dependencies]
+eframe = { workspace = true, features = ["accesskit"] }
+
 [dev-dependencies]
 egui_kittest = { workspace = true, features = ["eframe", "wgpu"] }
 pollster = "0.4"
